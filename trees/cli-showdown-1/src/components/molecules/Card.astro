---
import { validateCardProps, type CardProps } from '@/lib/schemas';

// Card component props with runtime validation
export interface Props extends CardProps {
  class?: string;
  id?: string;
}

// Validate props at runtime in development
if (import.meta.env.DEV) {
  try {
    validateCardProps(Astro.props);
  } catch (error) {
    console.error('Card props validation failed:', error);
  }
}

const {
  variant = 'default',
  padding = 'md',
  surface = 'flat',
  class: className = '',
  id,
} = Astro.props;

// Build classes
const baseClasses = [
  'card',
  `card--${variant}`,
  `card--padding-${padding}`,
  `card--surface-${surface}`,
  className,
]
  .filter(Boolean)
  .join(' ');
---

<div class={baseClasses} id={id}>
  <slot />
</div>

<style>
  .card {
    position: relative;
    display: block;
    border-radius: var(--radius-xl);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    isolation: isolate;
  }

  /* Padding Variants */
  .card--padding-none {
    padding: 0;
  }

  .card--padding-sm {
    padding: var(--space-sm);
  }

  .card--padding-md {
    padding: var(--space-lg);
  }

  .card--padding-lg {
    padding: var(--space-xl);
  }

  /* Card Variants */
  .card--default {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .card--glass {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border: 1px solid var(--glass-border);
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 var(--glass-highlight);
  }

  .card--elevated {
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-xl);
  }

  /* Surface Effects */
  .card--surface-flat {
    /* Inherits from variant */
  }

  .card--surface-glass {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border: 1px solid var(--glass-border);
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 var(--glass-highlight);
  }

  .card--surface-elevated {
    box-shadow: var(--shadow-xl);
    transform: translateY(0);
  }

  /* Hover Effects */
  .card:hover {
    transform: translateY(-2px);
  }

  .card--default:hover {
    box-shadow: var(--shadow-md);
  }

  .card--glass:hover {
    background: rgba(255, 255, 255, 0.15);
    box-shadow:
      var(--shadow-xl),
      inset 0 1px 0 var(--glass-highlight);
  }

  .card--elevated:hover {
    box-shadow: var(--shadow-2xl);
    transform: translateY(-4px);
  }

  /* Dark Mode Adjustments */
  [data-theme='dark'] .card--default {
    background: var(--color-surface);
    border-color: var(--color-border);
  }

  [data-theme='dark'] .card--glass {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow:
      var(--shadow-xl),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  [data-theme='dark'] .card--glass:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Active/Selected State */
  .card[aria-selected='true'],
  .card.card--selected {
    border-color: var(--color-brand-primary);
    box-shadow:
      0 0 0 2px var(--color-brand-primary),
      var(--shadow-lg);
  }

  /* Focus styles for accessibility */
  .card:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
    box-shadow:
      0 0 0 2px var(--color-brand-primary),
      0 0 20px rgba(59, 130, 246, 0.4),
      var(--shadow-lg);
  }

  /* Responsive design and accessibility */
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .card {
      border-width: 2px;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .card--glass {
      background: var(--color-surface);
      border-color: var(--color-border);
    }
  }

  /* Fallback for browsers without backdrop-filter support */
  @supports not (backdrop-filter: blur(10px)) {
    .card--glass,
    .card--surface-glass {
      background: rgba(255, 255, 255, 0.95);
      box-shadow: var(--shadow-lg);
    }

    [data-theme='dark'] .card--glass,
    [data-theme='dark'] .card--surface-glass {
      background: rgba(0, 0, 0, 0.95);
    }
  }
</style>
