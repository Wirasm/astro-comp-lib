---
import { validateBadgeProps, type BadgeProps } from '@/lib/schemas';

// Badge component props with runtime validation
export interface Props extends BadgeProps {
  class?: string;
}

// Validate props at runtime in development
if (import.meta.env.DEV) {
  try {
    validateBadgeProps(Astro.props);
  } catch (error) {
    console.error('Badge props validation failed:', error);
  }
}

const { text, variant = 'primary', size = 'md', class: className = '' } = Astro.props;

// Build classes
const baseClasses = ['badge', `badge--${variant}`, `badge--${size}`, className]
  .filter(Boolean)
  .join(' ');
---

<span class={baseClasses}>
  {text}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-sans);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-none);
    text-decoration: none;
    border-radius: var(--radius-full);
    cursor: default;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    user-select: none;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  /* Badge Sizes */
  .badge--sm {
    padding: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    min-height: 1.25rem;
  }

  .badge--md {
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    min-height: 1.5rem;
  }

  /* Badge Variants with Glass Morphism */
  .badge--primary {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-subtle);
    -webkit-backdrop-filter: var(--glass-subtle);
    color: var(--color-brand-primary);
    border: 1px solid var(--color-brand-primary);
    box-shadow:
      0 1px 3px 0 rgb(59 130 246 / 0.1),
      inset 0 1px 0 var(--glass-highlight);
  }

  .badge--secondary {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-subtle);
    -webkit-backdrop-filter: var(--glass-subtle);
    color: var(--color-brand-secondary);
    border: 1px solid var(--color-brand-secondary);
    box-shadow:
      0 1px 3px 0 rgb(139 92 246 / 0.1),
      inset 0 1px 0 var(--glass-highlight);
  }

  .badge--success {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-subtle);
    -webkit-backdrop-filter: var(--glass-subtle);
    color: var(--color-success);
    border: 1px solid var(--color-success);
    box-shadow:
      0 1px 3px 0 rgb(16 185 129 / 0.1),
      inset 0 1px 0 var(--glass-highlight);
  }

  .badge--warning {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-subtle);
    -webkit-backdrop-filter: var(--glass-subtle);
    color: var(--color-warning);
    border: 1px solid var(--color-warning);
    box-shadow:
      0 1px 3px 0 rgb(245 158 11 / 0.1),
      inset 0 1px 0 var(--glass-highlight);
  }

  .badge--danger {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-subtle);
    -webkit-backdrop-filter: var(--glass-subtle);
    color: var(--color-danger);
    border: 1px solid var(--color-danger);
    box-shadow:
      0 1px 3px 0 rgb(244 63 94 / 0.1),
      inset 0 1px 0 var(--glass-highlight);
  }

  /* Subtle animation on hover */
  .badge:hover {
    transform: translateY(-1px);
    box-shadow:
      0 2px 6px 0 rgb(0 0 0 / 0.1),
      inset 0 1px 0 var(--glass-highlight);
  }

  /* Dark mode enhancements */
  [data-theme='dark'] .badge {
    background: var(--glass-bg);
    box-shadow:
      0 1px 3px 0 rgb(0 0 0 / 0.2),
      inset 0 1px 0 var(--glass-highlight);
  }

  /* Focus styles for accessibility */
  .badge:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
    box-shadow:
      0 0 0 2px var(--color-brand-primary),
      0 0 20px rgba(59, 130, 246, 0.4),
      var(--shadow-sm);
  }

  /* Responsive design and accessibility */
  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }

    .badge:hover {
      transform: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .badge {
      border-width: 2px;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--color-surface);
    }
  }
</style>
