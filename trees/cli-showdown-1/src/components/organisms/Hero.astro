---
import { Icon } from 'astro-icon/components';
import Button from '@/components/atoms/Button.astro';
import { validateHeroProps, type HeroProps } from '@/lib/schemas';

// Hero component props with runtime validation
export interface Props extends HeroProps {
  class?: string;
}

// Validate props at runtime in development
if (import.meta.env.DEV) {
  try {
    validateHeroProps(Astro.props);
  } catch (error) {
    console.error('Hero props validation failed:', error);
  }
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref = '#',
  secondaryCtaText,
  secondaryCtaHref = '#',
  variant = 'center',
  surface = 'gradient',
  class: className = '',
} = Astro.props;

// Build classes
const baseClasses = ['hero', `hero--${variant}`, `hero--surface-${surface}`, className]
  .filter(Boolean)
  .join(' ');
---

<section class={baseClasses}>
  <div class="hero__background"></div>
  <div class="hero__container">
    <div class="hero__content">
      <h1 class="hero__title">{title}</h1>
      {subtitle && <p class="hero__subtitle">{subtitle}</p>}

      {
        (ctaText || secondaryCtaText) && (
          <div class="hero__actions">
            {ctaText && (
              <Button
                href={ctaHref}
                variant="primary"
                size="lg"
                surface="elevated"
                motionProfile="expressive"
              >
                {ctaText}
              </Button>
            )}
            {secondaryCtaText && (
              <Button
                href={secondaryCtaHref}
                variant="outline"
                size="lg"
                icon="lucide:arrow-right"
                iconPosition="right"
              >
                {secondaryCtaText}
              </Button>
            )}
          </div>
        )
      }
    </div>

    {
      variant === 'split' && (
        <div class="hero__visual">
          <div class="hero__visual-content">
            <Icon name="lucide:sparkles" class="hero__visual-icon" />
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-lg);
    display: grid;
    gap: var(--space-2xl);
  }

  /* Hero Content */
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hero__title {
    font-size: var(--text-6xl);
    font-weight: var(--font-weight-black);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tighter);
    margin: 0;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-wrap: balance;
  }

  .hero__subtitle {
    font-size: var(--text-xl);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 65ch;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  /* Layout Variants */
  .hero--center .hero__container {
    grid-template-columns: 1fr;
    text-align: center;
    align-items: center;
  }

  .hero--center .hero__content {
    align-items: center;
  }

  .hero--center .hero__subtitle {
    margin-left: auto;
    margin-right: auto;
  }

  .hero--left .hero__container {
    grid-template-columns: 1fr;
    text-align: left;
  }

  .hero--split .hero__container {
    grid-template-columns: 1fr 1fr;
    align-items: center;
  }

  /* Visual Element for Split Layout */
  .hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__visual-content {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-2xl);
    box-shadow:
      var(--shadow-2xl),
      inset 0 1px 0 var(--glass-highlight);
    animation: float 6s ease-in-out infinite;
  }

  .hero__visual-icon {
    width: 50%;
    height: 50%;
    color: var(--color-brand-primary);
  }

  /* Surface Backgrounds */
  .hero--surface-gradient .hero__background {
    background: linear-gradient(
      135deg,
      var(--color-brand-primary) 0%,
      var(--color-brand-secondary) 100%
    );
    opacity: 0.1;
  }

  .hero--surface-mesh .hero__background {
    background:
      radial-gradient(at 40% 20%, hsla(28, 100%, 74%, 0.3) 0px, transparent 50%),
      radial-gradient(at 80% 0%, hsla(189, 100%, 56%, 0.3) 0px, transparent 50%),
      radial-gradient(at 0% 50%, hsla(355, 100%, 93%, 0.3) 0px, transparent 50%),
      radial-gradient(at 80% 50%, hsla(340, 100%, 76%, 0.3) 0px, transparent 50%),
      radial-gradient(at 0% 100%, hsla(22, 100%, 77%, 0.3) 0px, transparent 50%),
      radial-gradient(at 80% 100%, hsla(242, 100%, 70%, 0.3) 0px, transparent 50%),
      radial-gradient(at 0% 0%, hsla(343, 100%, 76%, 0.3) 0px, transparent 50%);
    animation: mesh-move 20s ease-in-out infinite;
  }

  .hero--surface-glass .hero__background {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-intense);
    -webkit-backdrop-filter: var(--glass-intense);
  }

  /* Animations */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    33% {
      transform: translateY(-10px) rotate(2deg);
    }
    66% {
      transform: translateY(5px) rotate(-2deg);
    }
  }

  @keyframes mesh-move {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(30px, -30px) rotate(120deg);
    }
    66% {
      transform: translate(-20px, 20px) rotate(240deg);
    }
  }

  /* Dark Mode Adjustments */
  [data-theme='dark'] .hero__title {
    background: linear-gradient(135deg, rgb(147 197 253) 0%, rgb(165 243 252) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  [data-theme='dark'] .hero__subtitle {
    color: var(--color-text-secondary);
  }

  [data-theme='dark'] .hero--surface-gradient .hero__background {
    opacity: 0.05;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
    }

    .hero__container {
      padding: var(--space-xl) var(--space-md);
    }

    .hero--split .hero__container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero--split .hero__content {
      align-items: center;
    }

    .hero--split .hero__subtitle {
      margin-left: auto;
      margin-right: auto;
    }

    .hero__visual {
      max-width: 300px;
      margin: 0 auto;
    }

    .hero__actions {
      justify-content: center;
    }
  }

  /* Responsive design and accessibility */
  @media (prefers-reduced-motion: reduce) {
    .hero__visual-content,
    .hero--surface-mesh .hero__background {
      animation: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .hero__background {
      display: none;
    }

    .hero {
      background: var(--color-background);
    }
  }
</style>
