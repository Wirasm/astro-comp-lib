---
import { validateAboutProps, type AboutProps } from '@/lib/schemas';

// About component props with runtime validation
export interface Props extends AboutProps {
  class?: string;
}

// Validate props at runtime in development
if (import.meta.env.DEV) {
  try {
    validateAboutProps(Astro.props);
  } catch (error) {
    console.error('About props validation failed:', error);
  }
}

const {
  title,
  subtitle,
  content,
  image,
  stats,
  variant = 'default',
  class: className = '',
} = Astro.props;

// Build classes
const baseClasses = ['about', `about--${variant}`, className].filter(Boolean).join(' ');
---

<section class={baseClasses}>
  <div class="about__container">
    <div class="about__content-wrapper">
      <div class="about__content">
        <h2 class="about__title">{title}</h2>
        {subtitle && <p class="about__subtitle">{subtitle}</p>}
        <div class="about__description">
          <p>{content}</p>
        </div>

        {
          stats && stats.length > 0 && (
            <div class="about__stats">
              {stats.map((stat) => (
                <div class="about__stat">
                  <div class="about__stat-value">{stat.value}</div>
                  <div class="about__stat-label">{stat.label}</div>
                </div>
              ))}
            </div>
          )
        }
      </div>

      {
        image && variant === 'split' && (
          <div class="about__visual">
            <div class="about__image-wrapper">
              <img src={image} alt={title} class="about__image" loading="lazy" />
              <div class="about__image-decoration" />
            </div>
          </div>
        )
      }
    </div>

    {
      image && variant !== 'split' && (
        <div class="about__image-section">
          <img src={image} alt={title} class="about__image" loading="lazy" />
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    padding: var(--space-2xl) 0;
    position: relative;
    overflow: hidden;
  }

  .about__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .about__content-wrapper {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* Layout Variants */
  .about--default .about__content-wrapper {
    grid-template-columns: 1fr;
  }

  .about--split .about__content-wrapper {
    grid-template-columns: 1fr 1fr;
  }

  .about--centered {
    text-align: center;
  }

  .about--centered .about__content {
    margin: 0 auto;
    max-width: 800px;
  }

  .about--centered .about__stats {
    justify-content: center;
  }

  /* Content */
  .about__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .about__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    margin: 0;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--line-height-relaxed);
  }

  .about__description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .about__description p {
    margin: 0 0 var(--space-md) 0;
    max-width: 65ch;
  }

  .about__description p:last-child {
    margin-bottom: 0;
  }

  /* Stats */
  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .about__stat {
    flex: 1;
    min-width: 150px;
    padding: var(--space-lg);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-medium);
    -webkit-backdrop-filter: var(--glass-medium);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    box-shadow:
      var(--shadow-lg),
      inset 0 1px 0 var(--glass-highlight);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  .about__stat:hover {
    transform: translateY(-2px);
    box-shadow:
      var(--shadow-xl),
      inset 0 1px 0 var(--glass-highlight);
  }

  .about__stat-value {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-primary);
    line-height: 1;
    margin-bottom: var(--space-sm);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .about__stat-label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  /* Visual/Image */
  .about__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .about__image-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
  }

  .about__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-2xl);
    object-fit: cover;
  }

  .about__image-decoration {
    position: absolute;
    inset: -20px;
    background: var(--gradient-mesh-bg);
    border-radius: var(--radius-xl);
    opacity: 0.3;
    z-index: -1;
    animation: mesh-move 20s ease-in-out infinite;
  }

  .about__image-section {
    margin-top: var(--space-2xl);
    text-align: center;
  }

  .about__image-section .about__image {
    max-width: 100%;
    height: auto;
  }

  /* Animations */
  @keyframes mesh-move {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(20px, -20px) rotate(120deg);
    }
    66% {
      transform: translate(-15px, 15px) rotate(240deg);
    }
  }

  /* Dark Mode Adjustments */
  [data-theme='dark'] .about__stat-value {
    background: linear-gradient(135deg, rgb(147 197 253) 0%, rgb(165 243 252) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Mobile Styles */
  @media (max-width: 768px) {
    .about--split .about__content-wrapper {
      grid-template-columns: 1fr;
    }

    .about__stats {
      gap: var(--space-md);
    }

    .about__stat {
      min-width: calc(50% - var(--space-sm));
    }

    .about__stat-value {
      font-size: var(--text-3xl);
    }

    .about__visual {
      order: -1;
    }
  }

  @media (max-width: 480px) {
    .about__stat {
      min-width: 100%;
    }
  }

  /* Responsive design and accessibility */
  @media (prefers-reduced-motion: reduce) {
    .about__stat,
    .about__image-decoration {
      transition: none;
      animation: none;
    }

    .about__stat:hover {
      transform: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .about__stat {
      border-width: 2px;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: var(--color-surface);
    }

    .about__image-decoration {
      display: none;
    }
  }
</style>
